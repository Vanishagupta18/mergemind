{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Docker Compose",
      "type": "shell",
      "command": "docker compose up -d",
      "problemMatcher": []
    },
    {
  "label": "FastAPI",
  "type": "shell",
  "command": "${workspaceFolder}\\backend\\venv\\Scripts\\uvicorn.exe",
  "args": [
    "main:app",
    "--reload",
    "--port",
    "8000"
  ],
  "options": {
    "cwd": "${workspaceFolder}\\backend"
  },
  "isBackground": true,
  "problemMatcher": []
},{
  "label": "Celery",
  "type": "shell",
  "command": "${workspaceFolder}\\backend\\venv\\Scripts\\celery.exe",
  "args": [
    "-A",
    "worker",
    "worker",
    "--loglevel=info",
    "--pool=solo"
  ],
  "options": {
    "cwd": "${workspaceFolder}\\backend"
  },
  "isBackground": true,
  "problemMatcher": []
},
    {
      "label": "Ngrok",
      "type": "shell",
      "command": "ngrok http 8000",
      "isBackground": true,
      "problemMatcher": []
    },
 {
  "label": "Start Project",
  "dependsOn": [
    "Docker Compose",
    "FastAPI",
    "Celery",
    "Ngrok"
  ],
  "dependsOrder": "parallel",
  "group": {
    "kind": "build",
    "isDefault": true
  }
}
]
}